g)={-rs.best_score_:.4f}  params={ {k.replace('m__',''): v for k, v in rs.best_params_.items()} }  ({time.time()-t:.0f}s)\")\n    tune_rows.append(evaluate(rs.best_estimator_, n))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-11T11:14:17.329134Z","iopub.execute_input":"2026-11-11T11:14:17.329547Z","iopub.status.idle":"2026-11-11T11:21:50.632927Z","shell.execute_reply.started":"2026-11-11T11:14:17.329524Z","shell.execute_reply":"2026-11-11T11:21:50.632044Z"}},"outputs":[{"name":"stdout","text":"Random Forest (tuned): best CV RMSE(log)=0.2159  params={'n_estimators': 150, 'min_samples_leaf': 1, 'max_features': 0.4, 'max_depth': None}  (185s)\nGradient Boosting (tuned): best CV RMSE(log)=0.2155  params={'subsample': 0.9, 'n_estimators': 200, 'max_depth': 7, 'learning_rate': 0.2}  (207s)\nHistGradientBoosting (tuned): best CV RMSE(log)=0.2177  params={'min_samples_leaf': 10, 'max_leaf_nodes': 63, 'max_iter': 1000, 'learning_rate': 0.03, 'l2_regularization': 1}  (60s)\n","output_type":"stream"}],"execution_count":16},{"id":"72b7e35c-bb0b-4311-86db-dc7283c80457","cell_type":"markdown","source":"## 10. Model comparison (validation set)","metadata":{}},{"id":"a0dc6cd2-8a49-4b97-a6b3-8c63233cbb5a","cell_type":"code","source":"comp = pd.concat([base_df.drop(columns=\"Time(s)\"), pd.DataFrame(tune_rows)]).sort_values(\"RMSE\").reset_index(drop=True)\ndisplay(comp) if \"display\" in globals() else print(comp)\nfig, ax = plt.subplots(1, 2, figsize=(14, 5))\nsns.barplot(data=comp, y=\"Model\", x=\"RMSE\", ax=ax[0], color=\"#4c78a8\"); ax[0].set_title(\"Validation RMSE (lower is better)\")\nsns.barplot(data=comp, y=\"Model\", x=\"R2\", ax=ax[1], color=\"#54a24b\"); ax[1].set_title(\"Validation R² (higher is better)\"); ax[1].set_xlim(comp.R2.min() - .02, 1)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-11T11:21:50.634029Z","iopub.execute_input":"2026-11-11T11:21:50.634451Z","iopub.status.idle":"2026-11